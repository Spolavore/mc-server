# copie para .env e ajuste
RCON_PASSWORD=troque-esta-senha
# nicks dos jogadores que serao op, separados por virgula
OPS=
# tipo de mundo: minecraft:normal (vanilla) ou o preset BetterX do WorldWeaver
LEVEL_TYPE=minecraft:normal

# --- servidor de teste do ATM10 (compose.atm10.yaml) ---
# default e a VM: 4 CPUs, 8G de RAM. Os 455 mods custam ~1.4G de metaspace/GC/code cache
# em cima do heap, entao 4G de heap = ~5.4G de RSS e cabe no limite de 6G.
ATM10_MEMORY=4G
ATM10_MEM_LIMIT=6G
# 3 nucleos para o servidor, 1 para o SO
ATM10_CPUS=3.5
ATM10_APC=3
